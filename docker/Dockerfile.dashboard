# Technical limitation: Debian 12 does not ship Python 3.10 packages.
# Using python:3.10-slim ensures consistent runtime behavior with the
# local development environment tested on Python 3.10.
FROM python:3.10-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-dashboard.txt requirements-dashboard.txt
RUN pip install --break-system-packages --no-cache-dir -r requirements-dashboard.txt

COPY dashboard/ ./dashboard/
COPY trader_config.py trader_config.py

EXPOSE 8055

CMD ["python", "-m", "uvicorn", "dashboard.main:app", "--host", "0.0.0.0", "--port", "8055"]
